# Source PDFs are registered by SHA-256 and stored outside Git.
*.pdf
*.gz
vietstock_bctc/

# Local environments and caches.
.venv/
.gpu-venv/
.model-cache/
.tools/
.local-mongodb/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated/run artifacts. Registry manifests remain tracked.
output/**
!output/.gitkeep
data/incoming/**
!data/incoming/.gitkeep
data/immutable/**
!data/immutable/.gitkeep
data/local/**
!data/local/.gitkeep

# Secrets and local overrides.
.env
*.pem
*.key
config/local/
data/registered/*.lock
